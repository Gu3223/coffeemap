{
  "version": "2.0",
  "envId": "coffeemap-prod-d7gyys53d1a4cee03",
  "app": {
    "serviceName": "coffeemap",
    "root": ".",
    "framework": "vite",
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDir": "dist",
    "deployPath": "/",
    "envVariables": {
      "VITE_AMAP_PROXY": "https://coffeemap-prod-d7gyys53d1a4cee03-1491257715.ap-shanghai.app.tcloudbase.com/api/nearby",
      "VITE_AMAP_DETAIL_PROXY": "https://coffeemap-prod-d7gyys53d1a4cee03-1491257715.ap-shanghai.app.tcloudbase.com/api/place-detail",
      "VITE_AMAP_JS_KEY": "{{env.VITE_AMAP_JS_KEY}}",
      "VITE_AMAP_JS_SERVICE_HOST": "https://coffeemap-prod-d7gyys53d1a4cee03-1491257715.ap-shanghai.app.tcloudbase.com/api/amap-js"
    }
  },
  "functions": [
    {
      "name": "amap-nearby",
      "description": "高德周边搜索服务端代理，Key 只存函数环境变量",
      "timeout": 20,
      "envVariables": {
        "AMAP_KEY": "{{env.VITE_AMAP_KEY}}"
      }
    },
    {
      "name": "amap-place-detail",
      "description": "高德门店详情服务端代理，Key 只存函数环境变量",
      "timeout": 20,
      "envVariables": {
        "AMAP_KEY": "{{env.VITE_AMAP_KEY}}"
      }
    },
    {
      "name": "amap-js-proxy",
      "description": "高德 JS API 安全密钥受限代理",
      "timeout": 20,
      "envVariables": {
        "AMAP_JS_SECURITY_CODE": "{{env.AMAP_JS_SECURITY_CODE}}",
        "ALLOWED_ORIGINS": "https://coffeemap-coffeemap-prod-d7gyys53d1a4cee03.webapps.tcloudbase.com,http://localhost:5173"
      }
    }
  ]
}
