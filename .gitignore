node_modules/
dist/
# 小程序：Taro 产物与依赖（源码在 miniprogram/src，逻辑层在 shared/）
miniprogram/dist/
miniprogram/node_modules/
.npm-cache/
.env
.env.*
# 小程序代码上传私钥：拿到即可往小程序上传代码。仓库是公开的，绝不能提交。
# 正本放在仓库外的 ~/.config/wechat/，这里只是兜底，防止误拷进来。
*.key
private.*.key
!.env.example

# Stray git-internal files that were accidentally committed to the project root
# (anchored to root so real paths like dist/index.html stay tracked)
/HEAD
/config
/description
/index
/COMMIT_EDITMSG

# npm leftovers
/.package-lock.json
/_update-notifier-last-checked
